rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /mates/{mateId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /chatRooms/{roomId} {
      function isParticipant() {
        return request.auth != null && request.auth.uid in resource.data.participants;
      }

      // Transactions must be able to read a room before its first creation.
      allow get: if request.auth != null &&
        (!exists(/databases/$(database)/documents/chatRooms/$(roomId)) || isParticipant());
      allow list: if isParticipant();
      allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['participants', 'createdAt'])
          && request.resource.data.participants is list
          && request.resource.data.participants.size() == 2
          && request.resource.data.participants[0] is string
          && request.resource.data.participants[1] is string
          && request.resource.data.participants[0].matches('^[A-Za-z0-9_-]{1,128}$')
          && request.resource.data.participants[1].matches('^[A-Za-z0-9_-]{1,128}$')
          && roomId == request.resource.data.participants[0] + ':' + request.resource.data.participants[1]
          && request.resource.data.participants[0] != request.resource.data.participants[1]
          && request.auth.uid in request.resource.data.participants
          && exists(/databases/$(database)/documents/users/$(request.resource.data.participants[0]))
          && exists(/databases/$(database)/documents/users/$(request.resource.data.participants[1]))
          && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      match /messages/{messageId} {
        function belongsToRoom() {
          return request.auth != null && request.auth.uid in
            get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;
        }
        allow read: if belongsToRoom();
        allow create: if belongsToRoom()
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
